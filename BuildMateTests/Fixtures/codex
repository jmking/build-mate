    checker=thread+'-checker-'+turn;checker_turn='child-'+turn+'-checker';research=thread+'-research-'+turn
    if gate==0:
     # Parent completion activity arrives before the actual child turn finishes.
     activity(checker,'checker','completed')
    elif gate==1:
     event('turn/completed',{'threadId':checker,'turn':{'id':checker_turn,'status':'completed','items':[],'error':None}})
     # Reusing a completed child starts pending work before turn/started arrives.
     activity(research,'research','interacted',research+'-followup')
    else:
     followup='followup-'+turn
     event('turn/started',{'threadId':research,'turn':{'id':followup,'status':'inProgress','items':[]}})
     event('item/completed',{'threadId':research,'turnId':followup,'item':{'id':research+'-followup-result','type':'agentMessage','text':'Follow-up verified.'}})
     activity(research,'research','completed',research+'-followup-completed')
     event('turn/completed',{'threadId':research,'turn':{'id':followup,'status':'completed','items':[],'error':None}})
     activity(research,'research','started')
     activity(research,'research','interacted',research+'-followup')
    review()
   elif not req['result']['success']:
    if (root/'proof-efficiency').exists() and readstate().get('reviews')==1:
     text=req['result']['contentItems'][0]['text']
     assert 'Shared proof check' in text and 'proof diagnostic sentinel' in text
     assert 'fixture-proof-secret' not in text and '[REDACTED]' in text
     assert not list((root.parent/'Application Support/Build Mate/projects').rglob('fixture-recordings'))
     assert not list((root.parent/'Application Support/Build Mate/projects').rglob('fixture-screenshots'))
     (root/'proof-feedback.txt').write_text(text)
    (root/'proof-repaired').touch();review()
   else:
    receipt=json.loads(req['result']['contentItems'][0]['text'])
    for path in receipt['inspectedPaths']:
     assert pathlib.Path(path).exists()
     pathlib.Path(path).read_bytes()
    (root/'qa-inspected').write_text(json.dumps(receipt))
    while (root/'hold-qa').exists():time.sleep(0.05)
    call('complete_qa',{'proofToken':receipt['proofToken'],'inspectedPaths':receipt['inspectedPaths'],'assessment':'Inspected all fixture artifacts and checked the acceptance criteria. No unresolved defects.'})
 else:emit({'id':req.get('id'),'error':{'code':-32601,'message':'Unexpected fake method'}})
