#!/usr/bin/python3
"""Process-boundary fake: speaks real app-server JSONL; never contacts a service."""
import json, os, pathlib, subprocess, sys, time
root=pathlib.Path(os.environ['BUILD_MATE_FIXTURE']);root.mkdir(exist_ok=True)
log=root/'calls.jsonl'
thread='';cwd='';turn='';pending={};count=0;title_mode=False

def emit(value):print(json.dumps(value),flush=True)
def event(method,params):emit({'method':method,'params':params})
def reply(req,result):emit({'id':req['id'],'result':result})
def call(tool,args):
 global count
 count+=1;key='tool-'+str(count);pending[key]=tool
 emit({'id':key,'method':'item/tool/call','params':{'threadId':thread,'turnId':turn,'callId':key,'tool':tool,'arguments':args}})
def statepath():return root/(thread+'.json')
def readstate():return json.loads(statepath().read_text()) if statepath().exists() else {}
def save(**values):
 s=readstate();s.update(values);statepath().write_text(json.dumps(s))
def complete():event('turn/completed',{'threadId':thread,'turn':{'id':turn,'status':'completed','items':[],'error':None}})
def review():
 attempt=readstate().get('reviews',0)+1;save(reviews=attempt)
 report={'summary':'Adds the requested feature.','needsRecording':(root/'visual-task').exists(),
         'rationale':'Demonstrate the visual change.' if (root/'visual-task').exists() else 'Functional change verified by checking the generated feature.',
         'checks':[{'name':'Agent feature check','command':'test -f feature.txt && ! touch "$BUILD_MATE_FIXTURE/forbidden-write"'}]}
 if attempt==1 and (root/'omit-checks').exists():report['checks']=[]
 if attempt>1:
  report['recordingCommand']='printf invalid > "$BUILD_MATE_RECORDING_PATH"' if attempt==2 else 'cp "$BUILD_MATE_FIXTURE/proof.mp4" "$BUILD_MATE_RECORDING_PATH"'
 if (root/'legacy-review').exists():report={'summary':json.dumps(report)}
 call('request_review',report)
def build():
 pathlib.Path(cwd,'feature.txt').write_text('implemented\n')
 subprocess.run(['git','-C',cwd,'add','feature.txt'],check=True,stdout=subprocess.DEVNULL)
 subprocess.run(['git','-C',cwd,'-c','user.name=Fake Agent','-c','user.email=fake@example.invalid','commit','-m','Implement feature'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
 review()

for line in sys.stdin:
 req=json.loads(line)
 with log.open('a') as f:f.write(json.dumps({'method':req.get('method'),'id':req.get('id'),'params':req.get('params')})+'\n')
 method=req.get('method');p=req.get('params',{})
 if method=='initialize':reply(req,{'userAgent':'fake/0.151'})
 elif method=='initialized':pass
 elif method=='model/list':reply(req,{'data':[{'id':'fake-model','isDefault':True}],'nextCursor':None})
 elif method=='account/rateLimits/read':
  if (root/'usage-error').exists():emit({'id':req['id'],'error':{'code':-32000,'message':'Fixture usage unavailable'}})
  else:reply(req,json.loads((root/'usage.json').read_text()) if (root/'usage.json').exists() else {'rateLimits':{'primary':{'usedPercent':10}}})
 elif method=='thread/start':
  cwd=p['cwd'];thread='fixture-'+pathlib.Path(cwd).parent.name+'-'+pathlib.Path(cwd).name
  title_mode=p.get('ephemeral',False)
  if title_mode:
   assert p['sandbox']=='read-only' and p['approvalPolicy']=='never' and not p.get('dynamicTools')
   assert pathlib.Path(cwd).parent.name=='title-drafts'
  else:assert p['dynamicTools'] and p['sandbox']=='workspace-write' and p['approvalPolicy']=='never'
  save(cwd=cwd);reply(req,{'thread':{'id':thread}})
 elif method=='thread/resume':
  thread=p['threadId'];cwd=readstate()['cwd'];reply(req,{'thread':{'id':thread}})
 elif method=='turn/start':
  thread=p['threadId'];turn='turn-'+str(readstate().get('turns',0)+1);save(turns=readstate().get('turns',0)+1)
  if title_mode:
   assert p['sandboxPolicy']=={'type':'readOnly','networkAccess':False} and p['outputSchema']['required']==['title']
   reply(req,{'turn':{'id':turn,'status':'inProgress','items':[]}})
   if (root/'title-stall').exists():continue
   text='not JSON' if (root/'title-failure').exists() else json.dumps({'title':'Keep command output compact'})
   event('item/completed',{'threadId':thread,'turnId':turn,'item':{'id':'title','type':'agentMessage','text':text}})
   complete();continue
  assert p['sandboxPolicy']['excludeSlashTmp'] and p['sandboxPolicy']['excludeTmpdirEnvVar']
  reply(req,{'turn':{'id':turn,'status':'inProgress','items':[]}})
  if (root/'crash-once').exists():
   (root/'crash-once').unlink();sys.exit(7)
  if (root/'flood').exists():
   while True:
    event('item/agentMessage/delta',{'threadId':thread,'turnId':turn,'delta':'working '});time.sleep(0.005)
  if (root/'stall').exists():continue
  if not readstate().get('answered'):call('ask_question',{'prompt':'Which output?','options':['Plain','Rich'],'allowsFreeText':True,'blocking':True})
  else:call('submit_plan',{'plan':'Implement the chosen plain output, then run checks.'})
 elif method=='turn/steer':reply(req,{'turnId':turn})
 elif method=='turn/interrupt':reply(req,{});event('turn/completed',{'threadId':thread,'turn':{'id':turn,'status':'interrupted','items':[]}})
 elif 'id' in req and req['id'] in pending:
  tool=pending.pop(req['id'])
  if tool=='ask_question':
   assert req['result']['contentItems'][0]['text']=='Plain';save(answered=True)
   time.sleep(0.05)
   call('submit_plan',{'plan':'Implement the chosen plain output, then run checks.'})
  elif tool=='submit_plan':build()
  elif tool=='request_review':
   if not req['result']['success']:
    (root/'proof-repaired').touch();review()
   else:complete()
 else:emit({'id':req.get('id'),'error':{'code':-32601,'message':'Unexpected fake method'}})
