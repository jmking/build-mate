#!/usr/bin/python3
import json,os,pathlib,sys
root=pathlib.Path(os.environ['BUILD_MATE_FIXTURE']);a=sys.argv[1:]
with (root/'gh-calls.jsonl').open('a') as f:f.write(json.dumps(a)+'\n')
if (root/'missing-gh').exists():sys.exit(127)
pr={'number':42,'url':'https://github.com/fixture/repo/pull/42','baseRefName':'main'}
if a[:2]==['auth','status']:
 sys.exit(1 if (root/'signed-out').exists() else 0)
elif a[:2]==['repo','view']:print(json.dumps({'nameWithOwner':'fixture/repo','defaultBranchRef':{'name':'main'}}))
elif a[:2]==['pr','list']:print(json.dumps([pr] if (root/'pr-created').exists() else []))
elif a[:2]==['pr','create']:
 body=pathlib.Path(a[a.index('--body-file')+1]).read_text()
 assert body==('- Adds the requested feature.\n- Preserves **existing behavior**.' if (root/'json-pr-summary').exists() else 'Adds the requested feature.')
 assert a[a.index('--base')+1]=='main'
 (root/'pr-body').write_text(body);(root/'pr-head').write_text(a[a.index('--head')+1]);(root/'pr-created').touch();print(pr['url'])
elif a[:2]==['pr','edit']:
 assert a[2]=='42' and (root/'pr-created').exists()
 assert not (root/'merged').exists() and not (root/'pr-closed').exists()
 body=pathlib.Path(a[a.index('--body-file')+1]).read_text()
 assert body==('- Changes the feature to blue.\n- Preserves **existing behavior**.' if (root/'pr-revision').exists() else '- Adds the requested feature.\n- Preserves **existing behavior**.' if (root/'json-pr-summary').exists() else 'Adds the requested feature.')
 (root/'pr-body').write_text(body);print(pr['url'])
elif a[:2]==['pr','view']:
 state='MERGED' if (root/'merged').exists() else 'CLOSED' if (root/'pr-closed').exists() else 'OPEN'
 detail={**pr,'state':state,'headRefName':(root/'pr-head').read_text() if (root/'pr-head').exists() else ''}
 print(json.dumps({key:detail[key] for key in a[a.index('--json')+1].split(',')}))
else:sys.exit('Unexpected gh command')
