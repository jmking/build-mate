#!/usr/bin/python3
# Fake Bitbucket Cloud TWG CLI. Fails closed unless a test opts in with the `bitbucket` marker,
# so a GitHub test can never fall through to real TWG. Shapes mirror recorded twg 1.3.1 output.
import json,os,pathlib,sys,subprocess
root=pathlib.Path(os.environ['BUILD_MATE_FIXTURE'])
if not (root/'bitbucket').exists():
 sys.stderr.write('Unexpected Bitbucket invocation in GitHub core test\n');sys.exit(99)
a=sys.argv[1:]
with (root/'twg-calls.jsonl').open('a') as f:f.write(json.dumps(a)+'\n')
if (root/'missing-twg').exists():sys.exit(127)
def fail(message):print(json.dumps({'ok':False,'error':{'message':message,'retry':{'recommended':False}}}));sys.exit(1)
def arg(name):return a[a.index(name)+1]
def read(name,default):return json.loads((root/name).read_text()) if (root/name).exists() else default
assert a[0]=='bitbucket' and arg('--workspace') and arg('--repo') and arg('--output-summary')=='none'
if (root/'bb-signed-out').exists():fail('Bitbucket authentication failed. Run twg setup bitbucket.')
a=a[1:]
branch=(root/'pr-head').read_text() if (root/'pr-head').exists() else ''
def full_head():
 out=subprocess.check_output(['git','ls-remote','origin','refs/heads/'+branch],text=True) if branch else ''
 return out.split()[0] if out else 'unknown'
def pr_summary():
 state='MERGED' if (root/'merged').exists() else 'DECLINED' if (root/'pr-closed').exists() else 'OPEN'
 return {'id':7,'state':state,'draft':False,'links':{'html':{'href':'https://bitbucket.org/fixture/repo/pull-requests/7'}},
  'source':{'branch':{'name':branch},'commit':{'hash':full_head()[:12]}},'destination':{'branch':{'name':(root/'pr-base').read_text() if (root/'pr-base').exists() else 'main'}}}
def comments():
 values=[{'id':v['id'],'content':{'raw':v['body']},'deleted':False,'pending':False,'inline':None,'resolution':None} for v in read('review-feedback',[])]
 if (root/'thread-feedback').exists():
  values.append({'id':102,'content':{'raw':'Keep the existing account filter while changing the color.'},'deleted':False,'pending':False,
   'inline':{'path':'feature.txt','to':1,'outdated':False},'resolution':{} if (root/'thread-resolved').exists() else None})
 for v in read('posted-replies',[]):
  values.append({'id':v['id'],'content':{'raw':v['body']},'deleted':False,'pending':False,'parent':{'id':v['parent']} if v.get('parent') else None,
   'inline':{'path':'feature.txt','to':1} if v.get('parent')==102 else None,'resolution':None})
 return values
if a[:2]==['repo','get']:print(json.dumps({'full_name':'fixture/repo','mainbranch':{'name':'main'}}))
elif a[:2]==['pull-requests','query']:
 assert arg('--state')=='OPEN'
 print(json.dumps([pr_summary()] if (root/'pr-created').exists() and arg('--source')==branch else []))
elif a[:2]==['pull-requests','create']:
 assert arg('--dest')=='main'
 body=pathlib.Path(arg('--description-file')).read_text();assert body=='Adds the requested feature.',body
 (root/'pr-head').write_text(arg('--source'));(root/'pr-created').touch();branch=arg('--source');print(json.dumps(pr_summary()))
elif a[:2]==['pull-requests','update']:
 assert arg('--pull-request')=='7' and not (root/'merged').exists()
 if '--dest' in a:(root/'pr-base').write_text(arg('--dest'))
 if '--description-file' in a:
  body=pathlib.Path(arg('--description-file')).read_text()
  assert body=='Adds the requested feature.',body
 print(json.dumps(pr_summary()))
elif a[:2]==['pull-requests','get']:
 detail=pr_summary()
 detail['participants']=[{'user':{'account_id':'reviewer-1','display_name':'Riley Reviewer'},'role':'REVIEWER','approved':(root/'merge-ready').exists() and not (root/'bb-changes-requested').exists(),
  'state':'changes_requested' if (root/'bb-changes-requested').exists() else 'approved' if (root/'merge-ready').exists() else None,'participated_on':'2026-09-28T01:00:00Z'}]
 if '--statuses' in a:
  detail['_statuses']=[{'key':'pipeline','name':'Pipeline','state':'FAILED','url':'https://bitbucket.org/fixture/repo/pipelines/results/12','commit':{'hash':full_head()}}] if (root/'ci-failed').exists() else []
 print(json.dumps(detail))
elif a[:2]==['pull-requests','conflicts']:print('[]')
elif a[:3]==['pull-requests','comment','query']:print(json.dumps(comments()))
elif a[:3]==['pull-requests','comment','create']:
 posts=read('posted-replies',[]);post={'id':300+len(posts),'body':arg('--text'),'parent':int(arg('--reply-to')) if '--reply-to' in a else None}
 posts.append(post);(root/'posted-replies').write_text(json.dumps(posts))
 if (root/'lose-reply-response').exists():
  (root/'lose-reply-response').unlink();fail('Request timed out.')
 print(json.dumps({'id':post['id'],'content':{'raw':post['body']}}))
elif a[:3]==['pull-requests','comment','resolve']:
 assert arg('--comment')=='102';(root/'thread-resolved').touch();print(json.dumps({'id':102,'status':'resolved'}))
elif a[:3]==['pull-requests','task','query']:
 print(json.dumps([{'id':55,'state':'RESOLVED' if (root/'task-resolved').exists() else 'UNRESOLVED','content':{'raw':'Add a changelog entry.'}}] if (root/'bb-task').exists() else []))
elif a[:3]==['pull-requests','task','resolve']:
 assert arg('--task')=='55';(root/'task-resolved').touch();print(json.dumps({'id':55,'state':'RESOLVED'}))
elif a[:2]==['branch','query']:
 strategies=['merge_commit','squash'] if (root/'no-fast-forward').exists() else ['merge_commit','squash','fast_forward']
 print(json.dumps([{'name':'main-old'},{'name':'main','default_merge_strategy':'squash','merge_strategies':strategies}]))
elif a[:2]==['pull-requests','merge']:
 assert (root/'merge-ready').exists() and '--wait' in a
 (root/'merge-requested').write_text(arg('--merge-strategy'));(root/'merged').touch()
 print(json.dumps({'ok':True,'action':'merge','status':'merged','pullRequest':7}))
elif a[:2]==['pipeline','get']:
 assert arg('--pipeline')=='12'
 if '--logs' in a:print(json.dumps({'build_number':12,'steps':[{'name':'check','log':'Runner temporarily lost its network connection. No tests ran.'}]}))
 else:print(json.dumps({'build_number':12,'run_number':1,'state':{'name':'COMPLETED','result':{'name':'FAILED'}},'target':{'commit':{'hash':full_head()}}}))
elif a[:2]==['pipeline','rerun-failed']:(root/'ci-retried').touch();print(json.dumps({'ok':True}))
else:fail('Unexpected fake twg command: '+' '.join(a))
